QMainWindow, QDialog, QMessageBox { background: $chrome; }
QWidget { color: $text; }
QLabel[muted="true"] { color: $muted; }
QMenuBar { background: $chrome; color: $muted; padding: 2px 8px; }
QMenuBar::item { padding: 4px 10px; border-radius: 5px; }
QMenuBar::item:selected { background: $selected; color: $selected_text; }
QMenu { background: $surface; border: 1px solid $line; padding: 5px; }
QMenu::item { padding: 7px 24px 7px 20px; border-radius: 5px; }
QMenu::item:selected { background: $selected; color: $selected_text; }
QMenu::item:disabled { color: $disabled; }
QMenu::separator { height: 1px; background: $line; margin: 4px 8px; }
QToolTip { background: $text; color: $surface; border: 1px solid $line; padding: 5px; }

#masthead, #toolbar, #documentTabs, #footer { background: $chrome; }
#brand { font-size: 16px; font-weight: 700; }
#mastDivider { background: $line; min-width: 1px; max-width: 1px; max-height: 19px; }
#filename { font-size: 13px; }
#lockState { color: $accent; font-weight: 650; }
#mastButton, #mastSave, #updateButton { min-width: 61px; min-height: 29px; }
#mastSave, #emptyOpen, QPushButton[primary="true"] {
    color: $on_accent; background: $accent; border-color: $accent; font-weight: 650;
}
#mastSave:hover, #emptyOpen:hover, QPushButton[primary="true"]:hover { background: $accent_hover; border-color: $accent_hover; }
#mastSave:focus, #emptyOpen:focus, QPushButton[primary="true"]:focus { border-color: $text; }
#mastSave:disabled { color: $disabled; background: $quiet; border-color: $line; }
#updateButton { color: $selected_text; background: $selected; }

#documentTabs { padding: 1px 8px 2px; }
#documentTabs::tab {
    color: $muted; background: $panel; border: 1px solid $line; border-radius: 7px;
    padding: 4px 7px 4px 11px; margin-right: 4px; min-width: 84px; max-width: 218px; min-height: 22px;
}
#documentTabs::tab:hover { background: $hover; }
#documentTabs::tab:selected { background: $surface; color: $selected_text; font-weight: 650; }
#documentTabs::tab:focus { border-color: $focus; }
#tabClose { background: transparent; border: 1px solid transparent; border-radius: 5px; min-height: 0; padding: 0; }
#tabClose:hover { background: $hover; }
#tabClose:focus { border-color: $focus; }

#toolCluster { background: $panel; border: 1px solid $line; border-radius: 9px; }
#toolCluster QPushButton, #toolbar > #arrow {
    background: transparent; border: 1px solid transparent; border-radius: 6px; min-height: 26px;
}
#toolCluster QPushButton:hover, #toolbar > #arrow:hover { background: $hover; }
#toolCluster QPushButton:checked { background: $surface; border-color: $line; }
#toolCluster QPushButton:focus, #toolbar > #arrow:focus { border-color: $focus; }
#toolCluster QPushButton:disabled { background: transparent; }
#toolCluster QSpinBox, #toolCluster QComboBox { min-height: 21px; padding: 1px 5px; }
#toolIcon { min-width: 27px; padding: 0 2px; }
#arrow { font-size: 16px; min-width: 24px; padding: 0 3px; }
#searchBox { border-radius: 9px; }

#sidebar, #inspector { background: $panel; border: 1px solid $line; border-radius: 12px; }
#panelTitle { font-size: 12px; font-weight: 700; color: $muted; padding: 1px 3px 2px; }
#route { background: $quiet; border: 1px solid $line; border-radius: 8px; }
#routeTab {
    font-weight: 650; color: $muted; padding: 0 3px; min-height: 27px;
    border: 1px solid transparent; background: transparent; border-radius: 5px;
}
#routeTab:hover { background: $hover; }
#routeTab:checked { background: $surface; border-color: $line; color: $selected_text; }
#routeTab:focus { border-color: $focus; }
#inspectorScroll, #toolGroup { background: $panel; }
#bookmarks, #thumbnails { border: 1px solid transparent; background: $panel; outline: 0; }
#bookmarks:focus, #thumbnails:focus { border-color: $focus; border-radius: 7px; }
#bookmarks::item { padding: 6px 1px; }
#thumbnails::item { border: 1px solid transparent; border-radius: 8px; padding: 4px; color: $muted; }
#thumbnails::item:hover, #bookmarks::item:hover { background: $hover; }
#thumbnails::item:selected, #bookmarks::item:selected { background: $selected; color: $selected_text; }
#thumbnails::item:selected { border: 1px solid $focus; }

#pageView, #emptyView { background: $canvas; border: 1px solid $line; border-radius: 12px; }
#emptyCard { background: $surface; border: 1px solid $line; border-radius: 17px; }
#emptySymbol { background: $selected; border-radius: 21px; }
#emptyTitle { font-size: 27px; font-weight: 700; }
#emptyCard QPushButton { min-height: 34px; }
#emptyOpen { min-width: 98px; }
#footer { border-top: 1px solid $line; }

QPushButton { background: $surface; border: 1px solid $line; border-radius: 7px; padding: 1px 10px; min-height: 28px; }
QPushButton:hover { background: $hover; }
QPushButton:pressed { background: $selected; }
QPushButton:focus { border-color: $focus; }
QPushButton:disabled { background: $quiet; color: $disabled; }
QPushButton[destructive="true"]:enabled { color: $danger; }
#modeButton, #documentButton {
    min-height: 31px; text-align: left; padding-left: 10px; background: transparent; border-color: transparent;
}
#modeButton:hover, #documentButton:hover { background: $hover; }
#modeButton:focus, #documentButton:focus { border-color: $focus; }
#modeButton:checked { color: $selected_text; font-weight: 650; background: $selected; }
#modeButton:checked:disabled { color: $disabled; background: $quiet; }

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QPlainTextEdit, #organizeList {
    color: $text; background: $surface; border: 1px solid $line; border-radius: 7px;
    padding: 3px 7px; min-height: 23px; selection-background-color: $accent; selection-color: $on_accent;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus, QPlainTextEdit:focus, #organizeList:focus {
    border-color: $focus;
}
QLineEdit:disabled, QSpinBox:disabled, QComboBox:disabled { background: $quiet; color: $disabled; }
QComboBox QLineEdit { border: none; padding-left: 1px; }
QComboBox QAbstractItemView { background: $surface; selection-background-color: $accent; selection-color: $on_accent; }
#organizeList { padding: 4px; outline: 0; }
#organizeList::item { padding: 7px; border-radius: 5px; }
#organizeList::item:selected { background: $accent; color: $on_accent; }
#organizePreview { background: $canvas; border: 1px solid $line; border-radius: 8px; }

QScrollBar:vertical { background: transparent; width: 9px; margin: 0; }
QScrollBar:horizontal { background: transparent; height: 9px; margin: 0; }
QScrollBar::handle { background: $scroll; border-radius: 4px; min-height: 22px; min-width: 22px; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
